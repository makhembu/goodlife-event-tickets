# ==============================================================================
# GOODLIFE Radio 254 - Home Daemon Environment Configuration
# Location: /opt/goodlife-radio/daemon/.env
# ==============================================================================

# Server Network Settings
DAEMON_HOST=0.0.0.0
DAEMON_PORT=8060
LOG_LEVEL=INFO

# Shared HMAC Authentication Secret (Must match Next.js BFF and Liquidsoap hook)
GOODLIFE_RADIO_SECRET_KEY=change_this_to_a_random_32_byte_hex_secret_key

# AzuraCast Playout Engine Integration
AZURACAST_BASE_URL=http://127.0.0.1:8055
AZURACAST_API_KEY=your_azuracast_api_token_here
AZURACAST_STATION_ID=1

# NVIDIA NIM AI DJ Copywriter (Llama 3.1 8B Instruct)
NVIDIA_NIM_API_KEY=nvapi-your_nvidia_nim_api_key_here
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=meta/llama-3.1-8b-instruct

# Fish Audio Kenyan Voice Synthesizer (Primary)
FISH_AUDIO_API_KEY=your_fish_audio_api_key_here
FISH_AUDIO_MODEL_ID=speech-1.5
FISH_AUDIO_VOICE_ID=6801890ec345469d8818129e5bdd50dd

# Microsoft Edge-TTS Voice Synthesizer (Free Tier 1 Fallback)
EDGE_TTS_VOICE_MALE=sw-KE-RafikiNeural
EDGE_TTS_VOICE_FEMALE=sw-KE-ZuriNeural

# Local Storage Folders
STORAGE_RECORDINGS_PENDING=/var/goodlife/recordings/pending
STORAGE_RECORDINGS_MASTERED=/var/goodlife/recordings/mastered
STORAGE_DROPS_STOCK=/var/goodlife/drops/stock
STORAGE_TEMP_PROCESSING=/tmp/goodlife-processing

# Cloudflare R2 Archival Settings
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=goodlife
R2_PUBLIC_DOMAIN=https://assets.goodlife.co.ke

# Neon PostgreSQL Database (For Set Archival Records)
DATABASE_URL=postgresql://user:password@ep-cool-fog-123456.eu-central-1.aws.neon.tech/goodlife?sslmode=require
