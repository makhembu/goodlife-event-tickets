# ==============================================================================
# GOODLIFE Radio 254 - Home Server Environment Configuration
# Target Host: Ubuntu Server 24.04 LTS (192.168.100.29)
# Copy this file to .env on the server: cp .env.example .env
# ==============================================================================

# Timezone (Kenya Standard Time / EAT)
TZ=Africa/Nairobi

# AzuraCast Station Identification
STATION_NAME="GOODLIFE Radio 254"
STATION_SHORTCODE=goodlife_radio_254
STATION_TIMEZONE=Africa/Nairobi

# Admin Initial Credentials
AZURACAST_ADMIN_EMAIL=admin@goodlife.co.ke
AZURACAST_ADMIN_PASSWORD=change_this_to_strong_admin_password_123

# Harbor Live DJ Ingest Credentials (Used in BUTT, OBS, Rekordbox, Serato)
# DJs connect to: live-dj.darajadigital.com (or server IP 192.168.100.29:8005)
HARBOR_PORT=8005
HARBOR_MOUNT=/live
HARBOR_USER=source
HARBOR_PASSWORD=change_this_to_live_dj_harbor_secret_key

# Internal Goodlife Bridge Key (Shared HMAC Secret between Daemon & Next.js BFF)
# Used to verify requests from Next.js (/admin/radio) and disconnect webhooks
GOODLIFE_RADIO_SECRET_KEY=change_this_to_a_random_32_byte_hex_secret_key

# Cloudflare Tunnel Configuration
# Tunnel UUID created via `cloudflared tunnel create goodlife-radio`
CLOUDFLARE_TUNNEL_ID=your_cloudflare_tunnel_uuid_here
CLOUDFLARE_TUNNEL_CRED_FILE=/etc/cloudflared/your_cloudflare_tunnel_uuid_here.json

# Local Storage Paths (Created by setup-station.sh)
STORAGE_RECORDINGS_PATH=/var/goodlife/recordings
STORAGE_DROPS_PATH=/var/goodlife/drops
