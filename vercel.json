{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/radio-schedule",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/radio-reminders",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/radio-drops",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/radio-health-monitor",
      "schedule": "*/5 * * * *"
    }
  ]
}
