# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# NEON POSTGRES DATABASE
DATABASE_URL="postgresql://user:pass@host/neondb?sslmode=require"

# PAYHERO API (M-Pesa STK Push — settles instantly to your own till)
# Dashboard → API Keys: copy API Username + Password. Payment Channels → My Payment Channels: note channel ID.
PAYHERO_USERNAME="your_api_username"
PAYHERO_PASSWORD="your_api_password"
PAYHERO_CHANNEL_ID="123"
# Optional shared token appended to the webhook URL (?token=...) to guard /api/payhero/callback
PAYHERO_CALLBACK_TOKEN="random_long_secret"
# Fee-float guard: warn operators via WhatsApp when service wallet balance drops below this (default 50).
# STK pushes are blocked entirely when the wallet hits 0 (collections would fail anyway).
PAYHERO_MIN_BALANCE="50"

# PAYSTACK API (kept as alternative checkout option)
# Set NEXT_PUBLIC_ENABLE_PAYSTACK="true" in Vercel env vars to show the Paystack option at checkout.
# Default: hidden — checkout only offers PayHero M-Pesa + manual till.
NEXT_PUBLIC_ENABLE_PAYSTACK="false"
PAYSTACK_SECRET_KEY="sk_test_..."
PAYSTACK_PUBLIC_KEY="pk_test_..."

# WHATSAPP GATEWAY (OpenWA)
WHATSAPP_GATEWAY_URL="your_gateway_endpoint"
WHATSAPP_API_KEY="your_gateway_key"
WHATSAPP_SESSION_ID="your_session_uuid"

# VERCEL DEPLOYMENT TOKEN
# Used for `vercel --prod --token=$VERCEL_TOKEN` deploys
VERCEL_TOKEN="your_vercel_token"
